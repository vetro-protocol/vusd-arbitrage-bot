# ──────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────
ETHEREUM_RPC_URL=
PRODUCT=VUSD                  # VUSD or VETBTC

# ──────────────────────────────────────────────────────────────
# Wallet — optional (omit for DRY-RUN: polls + logs, no tx)
# ──────────────────────────────────────────────────────────────
PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────
# Optional address override — only set if arb contract was redeployed
# (REQUIRED for VETBTC until the contract is deployed and products.ts is updated)
# ──────────────────────────────────────────────────────────────
# ARBITRAGE_ADDRESS=

# ──────────────────────────────────────────────────────────────
# DEX aggregator API keys — 1inch + Matcha recommended, LiFi optional
# ──────────────────────────────────────────────────────────────
ONEINCH_API_KEY=
ZEROX_API_KEY=
LIFI_API_KEY=

# ──────────────────────────────────────────────────────────────
# Source toggles (all default true)
# ──────────────────────────────────────────────────────────────
# ENABLE_ONEINCH=false
# ENABLE_ZEROX=false
# ENABLE_LIFI=false
# ENABLE_CURVE_ROUTER=false

# ──────────────────────────────────────────────────────────────
# Tunings — all optional. Defaults from src/products.ts.
# Values are in the product's underlying base asset (USDC / WBTC).
# ──────────────────────────────────────────────────────────────
# MIN_PROFIT_BASE=5                       # VUSD default; VETBTC default 0.0001
# ESTIMATED_GAS_COST_BASE=5               # VUSD default; VETBTC default 0.00006
# MAX_FLASH_AMOUNT=1000000                # human units (1,000,000 USDC for VUSD)
# FLASH_AMOUNT_TIERS=[[500,2000],[200,1000],[50,500],[0,500]]
POLL_INTERVAL_MS=5000
MAX_GAS_PRICE_GWEI=50
SLIPPAGE_BPS=50

# ──────────────────────────────────────────────────────────────
# Transaction submission
# Arb windows last ~1 block. Sent publicly, the tx lands in a later block where
# the edge is already gone and reverts, burning gas. Protect drops a
# would-be-revert instead of mining it, so a lost race is free.
# ──────────────────────────────────────────────────────────────
# SEND_RPC_URL=https://rpc.flashbots.net/fast?blocksToLive=1
#                             # default. blocksToLive=1 matters: the Protect
#                             # default (~25 blocks) keeps re-offering a dead
#                             # arb for ~5 minutes. Set to ETHEREUM_RPC_URL to
#                             # go back to the public mempool.
# INCLUSION_TIMEOUT_MS=30000  # after this, a tx is treated as dropped (expected)

# ──────────────────────────────────────────────────────────────
# Deployment only
# ──────────────────────────────────────────────────────────────
# KEEPER_ADDRESS=
# OWNER_ADDRESS=
# KEEPER_SHARE_BPS=0
# ETHERSCAN_API_KEY=
# TREASURY_ADDRESS=        # Optional. Override the product's default treasury address.